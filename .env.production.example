# Template only. Store filled secrets outside the repository, in Koyeb Secrets.
APP_ENV=production
DEPLOYMENT_MODE=cloud
PORT=8000
DATABASE_URL=postgresql+psycopg://RUNTIME_USER:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
MIGRATION_DATABASE_URL=
DATABASE_SCHEMA=integracao_placas
DB_SSL_MODE=require
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000
API_ACCESS_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGINS=[]
VEHICLE_PROVIDER=FIPEPLACA
VEHICLE_API_URL=https://fipeplaca.com.br/api/v1
FIPEPLACA_API_KEY=
PARTS_PROVIDER=LOCAL_DB
FIPE_SYNC_ENABLED=false
FIPE_AUTO_UPDATE=false
FIPE_CACHE_ENABLED=true
PLATE_CACHE_TTL_DAYS=90
ERP_ENABLED=false
# Do not copy private AUTCOM credentials into Koyeb.
