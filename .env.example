# System Environment: 'development' (uses mock fallback) or 'production' (strictly real data)
APP_ENV="development"

PROJECT_NAME="AutoParts Plate & Applicability API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite for local dev without Docker, PostgreSQL for Docker)
DATABASE_URL="sqlite:///./autoparts.db"

# Plate Provider Configuration
# Options: MOCK, APIPLACA, PLACAFIPE, SERPRO
VEHICLE_PROVIDER="MOCK"
VEHICLE_API_URL=""
VEHICLE_API_KEY="" # Required for real queries in production mode
PLATE_CACHE_TTL_DAYS=90

# Parts Provider / Catalog Configuration
PARTS_PROVIDER="LOCAL_DB"
PARTS_API_URL=""
PARTS_API_KEY=""
