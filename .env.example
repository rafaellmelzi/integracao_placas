# Environment Configuration for AutoParts API
APP_ENV=development

# PostgreSQL Database Connection URL
# For Docker Compose: postgresql+psycopg://autoparts_user:autoparts_pass@db:5432/autoparts_db
# For Local SQLite: sqlite:///./autoparts.db
DATABASE_URL=postgresql+psycopg://autoparts_user:autoparts_pass@db:5432/autoparts_db

# Plate Lookup Provider Configuration
# Options: MOCK, FIPEPLACA, APIPLACA, PLACAFIPE, SERPRO
VEHICLE_PROVIDER=MOCK
VEHICLE_API_URL=https://fipeplaca.com.br/api/v1
VEHICLE_API_KEY=
FIPEPLACA_API_KEY=
PLATE_CACHE_TTL_DAYS=90

# Parts Catalog Provider Configuration
PARTS_PROVIDER=LOCAL_DB
PARTS_API_URL=
PARTS_API_KEY=

# FIPE Vehicle Synchronization Configuration
# Primary Provider: TABELAFIPE (TabelaFIPE.info - 100% Free Public API)
# Fallback Provider: PARALLELUM (Parallelum FIPE)
FIPE_PROVIDER=TABELAFIPE
FIPE_SYNC_ENABLED=true
FIPE_CACHE_ENABLED=true
FIPE_SYNC_DELAY=1.0
FIPE_AUTO_UPDATE=true

# External Read-Only ERP Connector (AUTCOM / Generic DB Integration)
ERP_ENABLED=false
ERP_DB_TYPE=mysql
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=3306
ERP_DB_NAME=autcom_db
ERP_DB_USER=autcom_reader
ERP_DB_PASSWORD=
ERP_QUERY_TIMEOUT_SECONDS=10
ERP_MAX_ROWS=5000

# Configurable Read-Only Product & Availability Queries (AUTCOM Schema Example)
ERP_PRODUCT_QUERY="SELECT CADITE.ITE_CODITE AS internal_code, CADITE.ITE_CODFAB AS factory_code, CADITE.ITE_DESITE AS description, CADMAR.MAR_DESMAR AS brand, CADITE.ITE_APLICA AS application FROM CADITE LEFT JOIN CADMAR ON CADITE.ITE_CODMAR = CADMAR.MAR_CODMAR WHERE UPPER(CADITE.ITE_APLICA) LIKE :vehicle_model"
ERP_AVAILABILITY_QUERY="SELECT ITEGER.ITE_CODITE AS internal_code, ITEGER.ITE_CODEMP AS company, ITEGER.ITE_SALDOS AS stock, ITEGER.ITE_PREVE1 AS price FROM ITEGER WHERE ITEGER.ITE_CODITE IN :codes"
